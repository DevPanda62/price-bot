# API anahtarlari (zirunlu). Koda ASLA hardcoded yazilmaz.
# Bu dosyayi kopyalayip .env olarak kaydedin, degerleri doldurun.
# GitHub Actions'ta: Settings > Secrets and variables > Actions

# Ana istemci anahtari (FastAPI ve Cloudflare Worker tarafindan okunur)
API_SECRET_KEY=degistir-ben-uzun-rastgele-bir-anahtar

# Ek istemci anahtarlari (virgulle ayrilmis). Farkli dIs projelere
# farkli anahtar vermek icin kullanilir (Cloudflare Worker destekler)
API_KEYS=istemci1-anahtari,istemci2-anahtari

# Opsiyonel: tarayici proxy adresi (sitelere engellenme durumunda)
PROXY_URL=

# FastAPI veri dizini (varsayilan docs)
DATA_DIR=docs

# Cloudflare Worker: Pages taban adresi
ORIGIN=https://kullanici.github.io/firsat-api
